rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Video call rules
    match /calls/{callId} {
      // Allow read/write if user is involved in the call
      allow read, write: if request.auth != null && 
        (resource.data.fromUserId == request.auth.uid || 
         resource.data.toUserId == request.auth.uid);
      
      // Allow create if user is the caller
      allow create: if request.auth != null && 
        request.resource.data.fromUserId == request.auth.uid;
      
      // Allow update if user is involved in the call
      allow update: if request.auth != null && 
        (resource.data.fromUserId == request.auth.uid || 
         resource.data.toUserId == request.auth.uid);
      
      // Allow delete if user is involved in the call
      allow delete: if request.auth != null && 
        (resource.data.fromUserId == request.auth.uid || 
         resource.data.toUserId == request.auth.uid);
      
      // ICE candidates subcollection
      match /candidates/{candidateId} {
        allow read, write: if request.auth != null && 
          get(/databases/$(database)/documents/calls/$(callId)).data.fromUserId == request.auth.uid ||
          get(/databases/$(database)/documents/calls/$(callId)).data.toUserId == request.auth.uid;
      }
    }
    
    // User rules (existing)
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Message rules (existing)
    match /messages/{messageId} {
      allow read, write: if request.auth != null && 
        (resource.data.senderId == request.auth.uid || 
         resource.data.receiverId == request.auth.uid);
    }
    
    // Post rules (existing)
    match /posts/{postId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
} 